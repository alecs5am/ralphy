{
  "version": "2.0",
  "name": "e2e-farm",
  "nodes": [
    {
      "id": "tick",
      "type": "schedule",
      "params": { "cron": "0 9 * * *" },
      "out": "tick"
    },
    {
      "id": "trends",
      "type": "trend-watch",
      "params": { "topics": ["fixture-topic"], "dedup_window": "7d" },
      "out": "items"
    },
    {
      "id": "write",
      "type": "generate-text",
      "in": { "sources": "trends.items" },
      "params": {
        "model": "anthropic/claude-fable-5",
        "provider": "openrouter",
        "prompt": "prompts/script.md"
      },
      "out": "script"
    },
    {
      "id": "image",
      "type": "t2i",
      "in": { "prompt": "write.script" },
      "params": {
        "provider": "openrouter",
        "model": "google/gemini-3-pro-image-preview",
        "project": "farm-e2e-001",
        "slot": "hero"
      },
      "out": "image"
    },
    {
      "id": "judge",
      "type": "generate-object",
      "in": { "prompt": "write.script" },
      "params": {
        "model": "anthropic/claude-opus-4-8",
        "provider": "openrouter",
        "prompt": "prompts/judge.md",
        "schema": "eval"
      },
      "out": { "name": "verdict", "type": "object:eval" }
    },
    {
      "id": "gate",
      "type": "gate",
      "in": { "verdict": "judge.verdict" },
      "params": {}
    },
    {
      "id": "unit",
      "type": "ralphy-unit",
      "in": { "media": "image.image", "gated": "gate.out" },
      "params": { "slug": "fixture-unit", "format": "video" },
      "out": "unit"
    },
    {
      "id": "approve",
      "type": "approval",
      "in": { "unit": "unit.unit" },
      "params": { "reason": "approve the finished unit before publishing" }
    },
    {
      "id": "slot",
      "type": "calendar-slot",
      "in": { "go": "approve.out" },
      "params": { "unit_type": "ugc-review", "platform": "tiktok" },
      "out": "slot"
    },
    {
      "id": "publish",
      "type": "publish",
      "in": { "unit": "unit.unit", "schedule_at": "slot.slot" },
      "params": { "targets": ["tiktok"] },
      "out": "published"
    },
    {
      "id": "analytics",
      "type": "analytics-pull",
      "in": { "after": "publish.published" },
      "params": {}
    }
  ]
}
