# Run unit + integration tests before every commit.
#
# Live-API tests (tests/live/) are intentionally excluded — they cost
# ~$0.15 per pass and require API keys to be set. Run them manually
# with `bun run test:live` before a release.
#
# Bypass with `git commit --no-verify` if you really need to.

# studio/test/ is fast (~4s) + fixture-backed (no network) — gated so a Studio
# server-contract regression is caught pre-commit (#494). The #061 cli-dryrun
# flake lives under tests/integration/, not the studio lane.
set -e
for key in $(git rev-parse --local-env-vars); do
  unset "$key"
done
bun test --timeout 45000 tests/unit/
bun test --timeout 45000 tests/integration/
if [ -d studio/test ]; then
  bun test --timeout 45000 studio/test/
fi
