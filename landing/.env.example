# Supabase — Library v2 backend. Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<region>
SUPABASE_S3_ACCESS_KEY_ID=<s3-access-key-id>
SUPABASE_S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
SUPABASE_STORAGE_BUCKET=library
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>     # DB writes (seed)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>         # runtime DB reads
