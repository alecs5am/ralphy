{
  "name": "ralphy-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast macOS media review workbench for Ralphy workspaces and projects.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "bun run build:renderer && bun run build:electron && electron .",
    "build": "bun run build:renderer && bun run build:electron",
    "benchmark": "bun scripts/benchmark-media.ts",
    "audit:instrument:shell": "bun scripts/audit-instrument-shell.mjs",
    "audit:instrument:marketplace": "bun scripts/audit-marketplace-instrument.mjs",
    "audit:instrument:source": "bun scripts/audit-instrument-source.mjs",
    "audit:instrument:electron": "bun scripts/audit-instrument-electron.mjs",
    "audit:instrument:accessibility": "bun scripts/audit-instrument-electron.mjs",
    "audit:media:fidelity": "bun scripts/audit-media-fidelity.mjs",
    "audit:instrument:final": "bun scripts/audit-instrument-final.mjs",
    "report:instrument": "bun scripts/render-instrument-report.mjs",
    "smoke": "bun run build && node scripts/smoke-electron.mjs",
    "smoke:packaged": "RALPHY_PACKAGED_APP='release/Ralphy Media.app' node scripts/smoke-electron.mjs",
    "smoke:secret-handoff": "RALPHY_PACKAGED_APP='release/Ralphy Media.app' node scripts/smoke-electron.mjs --secret-handoff",
    "icon:mac": "zsh scripts/build-mac-icon.sh",
    "package:mac": "bun run build && bun run icon:mac && node scripts/package-mac.mjs",
    "preview": "vite preview",
    "audit:style": "node scripts/audit-style-hygiene.mjs",
    "audit:style:strict": "STYLE_AUDIT_STRICT=1 node scripts/audit-style-hygiene.mjs"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@tanstack/react-virtual": "3.5.0",
    "boring-avatars": "2.0.4",
    "htmlparser2": "10.1.0",
    "lucide-react": "0.564.0",
    "marked": "16.4.2",
    "motion": "12.43.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wavesurfer.js": "7.12.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.2.0",
    "esbuild": "^0.24.2",
    "tailwindcss": "4.1.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "0.34.6"
  }
}
