{
  "name": "ugc-cli",
  "version": "0.3.0",
  "description": "Ralphy — open-source UGC video factory CLI. Monorepo root. Published binary is `@alecs5am/ralphy` (see npm/).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alecs5am/ralphy.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "ralphy": "./cli/index.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@openrouter/ai-sdk-provider": "2.10.0",
    "ai": "7.0.15",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "hyperframes": "^0.6.31",
    "image-size": "^2.0.2",
    "ora": "^9.4.0",
    "playwright": "^1.58.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.5",
    "husky": "^9.1.7",
    "prettier": "3.8.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build:bin": "tsx scripts/build-binaries.ts --smoke",
    "build:bin:current": "tsx scripts/build-binaries.ts --current --smoke",
    "lint": "tsc && bun run lint:errors && bun run lint:help-examples && bun run lint:skills && bun run lint:agents-md && bun run lint:mode-guidelines && bun run lint:gen-log && bun run lint:out-coverage && bun run lint:no-cyrillic && bun run cli:surface:check",
    "ralph": "bun cli/index.ts",
    "ralphy": "bun cli/index.ts",
    "setup": "bun cli/index.ts setup",
    "doctor": "bun cli/index.ts doctor",
    "render": "bun cli/index.ts render",
    "test": "bun test --timeout 45000 tests/",
    "test:unit": "bun test --timeout 45000 tests/unit/",
    "test:integration": "bun test --timeout 45000 tests/integration/",
    "test:live": "RUN_LIVE_TESTS=1 bun test --timeout 30000 tests/live/",
    "lint:errors": "bun run scripts/lint-error-codes.ts",
    "lint:help-examples": "bun run scripts/lint-help-examples.ts",
    "cli:surface:build": "bun run scripts/build-cli-surface.ts",
    "cli:surface:check": "bun run scripts/build-cli-surface.ts --check",
    "docs:cli": "bun run scripts/build-cli-docs.ts",
    "docs:cli:check": "bun run scripts/build-cli-docs.ts --check",
    "lint:docs-links": "bun run scripts/lint-docs-links.ts",
    "lint:docs-links:fast": "bun run scripts/lint-docs-links.ts --no-net",
    "lint:library": "bun run scripts/lint-library.ts",
    "lint:library:fast": "bun run scripts/lint-library.ts --no-net",
    "lint:skills": "bun run scripts/lint-skills.ts && bun run lint:skill-routing",
    "lint:skill-routing": "bun run scripts/lint-skill-routing.ts",
    "lint:agents-md": "bun run scripts/lint-agents-md.ts",
    "lint:mode-guidelines": "bun run scripts/lint-mode-guidelines.ts",
    "lint:confirmation-shape": "bun run scripts/lint-confirmation-shape.ts",
    "lint:motion-graphics": "bun run scripts/lint-motion-graphics.ts",
    "lint:gen-log": "bun run scripts/lint-gen-log-schema.ts",
    "lint:out-coverage": "bun run scripts/lint-out-coverage.ts",
    "lint:no-cyrillic": "bun run scripts/lint-no-cyrillic.ts",
    "smoke:modes": "bun run scripts/smoke-modes.ts",
    "prepare": "husky"
  }
}
