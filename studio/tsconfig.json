{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2022", "DOM"],
    "types": ["bun", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "vite.config.ts"]
}
